<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>You've been invited to an assessment</title>
</head>
<body style="font-family: Arial, sans-serif; background:#f4f4f7; padding: 24px;">
  <div style="max-width: 480px; margin: 0 auto; background:#ffffff; border-radius: 8px; padding: 32px;">
    <h2 style="color:#111827;">You're invited to take an assessment</h2>
    <p><strong><%= companyName %></strong> has invited you to complete:</p>
    <div style="background:#f3f4f6; border-radius: 6px; padding: 16px; margin: 16px 0;">
      <p style="margin:0; font-weight:bold; color:#111827;"><%= assessmentTitle %></p>
      <p style="margin:4px 0 0; color:#6b7280; font-size: 13px;"><%= durationMinutes %> minutes</p>
    </div>
    <% if (requiresRegistration) { %>
      <p>You don't have a SkillForge account yet — please register with <strong><%= email %></strong> first, then use the link below to accept.</p>
    <% } %>
    <div style="text-align:center; margin: 24px 0;">
      <a href="<%= inviteLink %>" style="display:inline-block; background:#111827; color:#ffffff; text-decoration:none; padding: 12px 28px; border-radius: 6px; font-weight:bold;">
        View Invitation
      </a>
    </div>
    <p>This invitation expires on <strong><%= expiresAt %></strong>.</p>
    <p style="color:#6b7280; font-size: 13px;">If you weren't expecting this, you can safely ignore this email.</p>
  </div>
</body>
</html>
